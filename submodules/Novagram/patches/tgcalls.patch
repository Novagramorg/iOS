+// Novagram: the audio thread never waits for the setter. try_lock fails only while a recording starts or stops,
+// and then one buffer is skipped. The shared_ptr copy keeps the tap alive for the call without allocating.
+void AudioDeviceIOS::setAudioTap(std::shared_ptr<NovagramAudioTap> tap) { // Novagram
+  std::lock_guard<std::mutex> lock(audioTapMutex_); // Novagram
+  audioTap_.swap(tap); // Novagram
+} // Novagram
+
+void AudioDeviceIOS::callAudioTap(const int16_t *pcm, size_t frames, size_t channels, uint32_t sampleRate, bool isPlayout) { // Novagram
+  std::shared_ptr<NovagramAudioTap> tap; // Novagram
+  if (audioTapMutex_.try_lock()) { // Novagram
+    tap = audioTap_; // Novagram
+    audioTapMutex_.unlock(); // Novagram
+  } // Novagram
+  if (tap && *tap) { // Novagram
+    (*tap)(pcm, frames, channels, sampleRate, isPlayout); // Novagram
+  } // Novagram
+} // Novagram
