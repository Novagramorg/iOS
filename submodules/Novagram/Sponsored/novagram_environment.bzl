"""Generates the Novagram ads environment constant as a Swift source file.

The only build input is `--define=novagramAdsEnvironment=development|production` (run.sh / release.sh /
publish.sh pass it from NOVAGRAM_ADS_ENVIRONMENT, only when it is set). The SDK binary carries everything
else it needs, so the app picks an environment and nothing more.

An empty value means production. Any other value than the two names fails the build, so a typo can never
silently select the wrong backend; the Swift side also falls back to production for an unknown name.
"""

_ENVIRONMENTS = ["development", "production"]

def _novagram_environment_source_impl(ctx):
    value = ctx.var.get("novagramAdsEnvironment", "").strip().lower()
    if value != "" and value not in _ENVIRONMENTS:
        fail("novagramAdsEnvironment must be empty, development or production")
    if value == "":
        value = "production"

    out = ctx.actions.declare_file(ctx.label.name + ".swift")
    ctx.actions.write(
        output = out,
        content = "\n".join([
            "// Generated by novagram_environment.bzl. Do not edit, do not commit.",
            "enum {} {{".format(ctx.attr.enum_name),
            "    static let name: String = \"{}\"".format(value),
            "}",
            "",
        ]),
    )
    return [DefaultInfo(files = depset([out]))]

# One rule, one define. `enum_name` lets the ads module and the Insights module each get their own
# generated enum, so neither depends on the other for it.
novagram_environment_source = rule(
    implementation = _novagram_environment_source_impl,
    attrs = {
        "enum_name": attr.string(mandatory = True),
    },
)
